<IfModule mod_rewrite.c>
RewriteEngine On

# Support and privacy shortcuts: must precede the general product redirects
RewriteRule ^(?:playlisty|pfam|playlisty-for-spotify|pfs)/support(?:/(.*))?$ /home/support/playlisty/$1 [R=301,L]
RewriteRule ^(?:playlisty|pfam|playlisty-for-spotify|pfs)/privacy/?$ /home/privacy/playlisty-privacy.html [R=301,L]

# Product aliases
RewriteRule ^(?:playlisty|pfam)(?:/(.*))?$ /home/pfam/$1 [R=301,L]
RewriteRule ^(?:playlisty-for-spotify|pfs)(?:/(.*))?$ /home/pfs/$1 [R=301,L]
RewriteRule ^wineplan(?:/(.*))?$ /home/wineplan/$1 [R=301,L]

# Support aliases
RewriteRule ^(?:faq|playlisty-faq|support/playlisty)(?:/(.*))?$ /home/support/playlisty/$1 [R=301,L]
RewriteRule ^support(?:/(.*))?$ /home/support/$1 [R=301,L]

# Redirect the site root
RewriteRule ^$ /home/ [R=301,L]

</IfModule>

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php83” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php83___lsphp .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
